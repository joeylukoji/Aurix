# AURIX API gateway — example environment. Copy to .env and adjust.

# "production" refuses dev seed keys (GATEWAY_SEED / FAUCET_SEED / AURIX_*_SEED / built-in defaults).
AURIX_ENV=development

CHAIN_RPC_URL=http://localhost:26657
CHAIN_REST_URL=http://localhost:1317
GUARDIAN_URL=http://localhost:8000
DATABASE_URL=sqlite:///./aurix.db
CORS_ORIGINS=*
ATTEST_POLL_INTERVAL=2

# ---- Signer keys (first match wins, per prefix GATEWAY_ = attestor/anchor signer, FAUCET_ = faucet) ----
# 1. BIP39 mnemonic (12/24 words), derived at m/44'/118'/0'/0/0 (cosmos coin type 118).
#    `aurixd keys add <name> --recover` with the same mnemonic shows the same aur1... address.
# GATEWAY_MNEMONIC="word1 word2 ... word24"
# FAUCET_MNEMONIC="word1 word2 ... word24"
# 2. File containing the 32-byte secp256k1 private key as hex (chmod 600).
# GATEWAY_KEY_FILE=/run/secrets/gateway.key
# FAUCET_KEY_FILE=/run/secrets/faucet.key
# 3. DEV ONLY: key = sha256(seed). Logs "dev seed key — never use on a public network"; refused in production.
#    Legacy names AURIX_GATEWAY_SEED / AURIX_FAUCET_SEED are still read. Defaults match the dev genesis.
# GATEWAY_SEED=aurix-dev-gateway
# FAUCET_SEED=aurix-dev-faucet

# ---- PayPal ----
PAYPAL_ENV=sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
