# PayPal: "simulator" (local paypal-sim, default in docker compose) or "sandbox".
# For the real Sandbox: PAYPAL_ENV=sandbox, PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# and the app's client id/secret + the webhook id from developer.paypal.com.
PAYPAL_ENV=
PAYPAL_BASE_URL=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Gateway CORS: comma separated origins allowed to call the gateway/faucet ("*" = any, dev only)
CORS_ORIGINS=*
CHAIN_RPC_URL=http://chain:26657
CHAIN_REST_URL=http://chain:1317
GUARDIAN_URL=http://guardian:8000
DATABASE_URL=sqlite:///./aurix.db
AURIX_FAUCET_SEED=
AURIX_GATEWAY_SEED=
