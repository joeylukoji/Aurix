  "components": {
    "schemas": {
      "ApproveReq": {
        "properties": {
          "confirm": {
            "type": "boolean",
            "title": "Confirm",
            "default": false
          }
        },
        "type": "object",
        "title": "ApproveReq"
      },
      "ArbiterActionReq": {
        "properties": {
          "action": {
            "type": "string",
            "title": "Action"
          }
        },
        "type": "object",
        "required": [
          "action"
        ],
        "title": "ArbiterActionReq"
      },
      "ConfirmReq": {
        "properties": {
          "confirm": {
            "type": "boolean",
            "title": "Confirm",
            "default": false
          }
        },
        "type": "object",
        "title": "ConfirmReq"
      },
      "EscrowOrderReq": {
        "properties": {
          "amount_usd": {
            "type": "string",
            "title": "Amount Usd"
          },
          "deadline_days": {
            "type": "integer",
            "title": "Deadline Days",
            "default": 7
          },
          "deadline_minutes": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deadline Minutes"
          },
          "carrier": {
            "type": "string",
            "title": "Carrier",
            "default": "aurix_demo_delivery"
          },
          "arbiter_key_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Arbiter Key Id"
          },
          "payer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Payer"
          },
          "description": {
            "type": "string",
            "title": "Description",
            "default": "AURIX conditional purchase"
          }
        },
        "type": "object",
        "required": [
          "amount_usd"
        ],
        "title": "EscrowOrderReq"
      },
      "EvidenceReq": {
        "properties": {
          "attestation": {
            "type": "object",
            "title": "Attestation"
          },
          "signature": {
            "type": "object",
            "title": "Signature"
          }
        },
        "type": "object",
        "required": [
          "attestation",
          "signature"
        ],
        "title": "EvidenceReq"
      },
      "ExplainReq": {
        "properties": {
          "audience": {
            "type": "string",
            "title": "Audience",
            "default": "buyer"
          },
          "lang": {
            "type": "string",
            "title": "Lang",
            "default": "French"
          }
        },
        "type": "object",
        "title": "ExplainReq"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "OrderReq": {
        "properties": {
          "amount_usd": {
            "type": "string",
            "title": "Amount Usd"
          },
          "payer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Payer"
          },
          "description": {
            "type": "string",
            "title": "Description",
            "default": "AURIX demo purchase"
          }
        },
        "type": "object",
        "required": [
          "amount_usd"
        ],
        "title": "OrderReq"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
