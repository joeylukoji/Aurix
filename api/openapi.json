{
  "openapi": "3.1.0",
  "info": {
    "title": "AURIX API Gateway",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/chain/status": {
      "get": {
        "summary": "Chain Status",
        "operationId": "chain_status_api_chain_status_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/wallets": {
      "post": {
        "summary": "New Wallet",
        "description": "Demo convenience: returns a fresh key. It is NOT stored server-side.\nThe web wallet generates keys in the browser instead.",
        "operationId": "new_wallet_api_wallets_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/wallets/{addr}": {
      "get": {
        "summary": "Wallet",
        "operationId": "wallet_api_wallets__addr__get",
        "parameters": [
          {
            "name": "addr",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Addr"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/wallets/{addr}/faucet": {
      "post": {
        "summary": "Faucet",
        "operationId": "faucet_api_wallets__addr__faucet_post",
        "parameters": [
          {
            "name": "addr",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Addr"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/txs/prepare": {
      "post": {
        "summary": "Prepare",
        "description": "Returns what the browser needs to build and sign a Cosmos tx, plus the advisory risk score.",
        "operationId": "prepare_api_txs_prepare_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PrepareReq"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/txs": {
      "post": {
        "summary": "Submit",
        "operationId": "submit_api_txs_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignedTx"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/txs/observed": {
      "post": {
        "summary": "Observed",
        "description": "Called by the wallet after it broadcast a tx directly to a node. The gateway fetches the tx\nfrom the chain itself and never trusts client-supplied fields.",
        "operationId": "observed_api_txs_observed_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ObservedTx"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/escrows": {
      "get": {
        "summary": "Escrows",
        "operationId": "escrows_api_escrows_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/escrows/{eid}": {
      "get": {
        "summary": "Escrow",
        "operationId": "escrow_api_escrows__eid__get",
        "parameters": [
          {
            "name": "eid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Eid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/proofs/{h}": {
      "get": {
        "summary": "Proof Normalised",
        "description": "Normalised chain proof: {hash, external_ref, capture_ref, status, attestations, threshold}.",
        "operationId": "proof_normalised_api_proofs__h__get",
        "parameters": [
          {
            "name": "h",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "H"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Msg": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type"
          },
          "to": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "To"
          },
          "amount": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Amount",
            "description": "uaur"
          },
          "arbiter": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Arbiter"
          },
          "deadline_height": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deadline Height"
          },
          "escrow_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Escrow Id"
          }
        },
        "type": "object",
        "required": [
          "type"
        ],
        "title": "Msg"
      },
      "ObservedTx": {
        "properties": {
          "txhash": {
            "type": "string",
            "title": "Txhash",
            "description": "hash of a tx the wallet broadcast directly to a chain node"
          }
        },
        "type": "object",
        "required": [
          "txhash"
        ],
        "title": "ObservedTx"
      },
      "PrepareReq": {
        "properties": {
          "from": {
            "type": "string",
            "title": "From"
          },
          "msg": {
            "$ref": "#/components/schemas/Msg"
          }
        },
        "type": "object",
        "required": [
          "from",
          "msg"
        ],
        "title": "PrepareReq"
      },
      "SignedTx": {
        "properties": {
          "tx_bytes": {
            "type": "string",
            "title": "Tx Bytes",
            "description": "base64 protobuf TxRaw signed by the user's key (SIGN_MODE_DIRECT)"
          }
        },
        "type": "object",
        "required": [
          "tx_bytes"
        ],
        "title": "SignedTx"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}